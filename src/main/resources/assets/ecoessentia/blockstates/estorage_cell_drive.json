{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "storage_level": "empty"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives_full"
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "empty"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives_full",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "empty"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives_full",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "empty"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c"
      },
      "apply": {
        "model": "ecoaeextension:storage_array_drives_full",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_a_essentia"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "b",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_b_essentia"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "c",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_c_essentia"
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_a_essentia",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "b",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_b_essentia",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "c",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_c_essentia",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_a_essentia",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "b",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_b_essentia",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "c",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_c_essentia",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_a_essentia",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "b",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_b_essentia",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "c",
        "storage_type": "essentia"
      },
      "apply": {
        "model": "ecoessentia:storage_array_drives_c_essentia",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c",
        "status": "idle"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_green"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c",
        "status": "run"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_blue_flash"
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c",
        "status": "idle"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_green",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c",
        "status": "run"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_blue_flash",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c",
        "status": "idle"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_green",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c",
        "status": "run"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_blue_flash",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c",
        "status": "idle"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_green",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c",
        "status": "run"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_down_blue_flash",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c",
        "storage_capacity": "empty"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_green"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c",
        "storage_capacity": "type_max"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_orange"
      }
    },
    {
      "when": {
        "facing": "north",
        "storage_level": "a|b|c",
        "storage_capacity": "full"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_red"
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c",
        "storage_capacity": "empty"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_green",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c",
        "storage_capacity": "type_max"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_orange",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "storage_level": "a|b|c",
        "storage_capacity": "full"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_red",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c",
        "storage_capacity": "empty"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_green",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c",
        "storage_capacity": "type_max"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_orange",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "storage_level": "a|b|c",
        "storage_capacity": "full"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_red",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c",
        "storage_capacity": "empty"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_green",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c",
        "storage_capacity": "type_max"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_orange",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "storage_level": "a|b|c",
        "storage_capacity": "full"
      },
      "apply": {
        "model": "ecoaeextension:led/array_disks_on_red",
        "y": 90
      }
    }
  ]
}
